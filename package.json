    "baseline:reproduce": "node scripts/reproduce.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parse5": "8.0.1",
    "typescript": "5.9.3"
  }
