{
  "name": "publication-reference-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.15.0", "npm": "10.8.2" },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
